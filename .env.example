# ActualForge local/source-build settings
ACTUALFORGE_PORT=5006

# Local builds are tagged "dev". Published deployments use
# compose.release.yaml together with .env.release.example.
ACTUALFORGE_TAG=dev
FINANCE_ENGINE_TAG=dev

# Optional Airtable bridge. Keep disabled until AIRTABLE_TOKEN and
# AIRTABLE_BASE_ID are supplied in an untracked .env file or secret store.
AIRTABLE_SYNC_ENABLED=false
AIRTABLE_BASE_ID=
AIRTABLE_SYNC_INTERVAL_MINUTES=15
# AIRTABLE_TOKEN=pat_...

# Secrets do not belong in this file when it is committed.
# Put deployment-specific secrets in an untracked .env file or Docker secrets.
